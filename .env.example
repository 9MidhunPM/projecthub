# Copy to .env for Compose; choose a local password. Do not commit real secrets.
# Use URL-safe alphanumeric characters because Compose interpolates this into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
# false only for loopback HTTP; set true with HTTPS before publishing.
COOKIE_SECURE=false
# Shell/local development; Prisma reads apps/api/.env, not this root file.
DATABASE_URL=postgresql://projecthub:replace-with-a-long-random-password@localhost:5432/projecthub?schema=public
API_INTERNAL_URL=http://localhost:4000
