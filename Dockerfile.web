FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci
COPY apps/web apps/web
ARG API_INTERNAL_URL=http://api:4000
ARG NODE_BUILD_OPTIONS=--max-old-space-size=1536
ENV API_INTERNAL_URL=$API_INTERNAL_URL NEXT_TELEMETRY_DISABLED=1
# Build-only heap cap leaves capacity for the host and other services.
RUN NODE_OPTIONS="$NODE_BUILD_OPTIONS" npm run build -w @projecthub/web

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_URL=http://api:4000
COPY --from=build --chown=node:node /app /app
USER node
EXPOSE 3000
CMD ["npm", "run", "start", "-w", "@projecthub/web"]
